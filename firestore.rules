rules_version = '2';

// 결산 체크리스트 보안 규칙
// - 읽기: 누구나 가능 (홈/체크리스트 화면은 로그인 없이 조회)
// - 쓰기: 로그인(관리자)한 사용자만 가능 (관리 화면에서 체크/입력)
service cloud.firestore {
  match /databases/{database}/documents {

    match /periods/{periodId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /items/{itemId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // 유럽법인 재고 수불부
    // - 읽기: 누구나 가능 (품목 목록/수불부 조회는 로그인 없이 가능)
    // - 쓰기: 로그인(관리자)한 사용자만 가능 (품목 등록, 입출고 등록)
    match /stockItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /movements/{movementId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // 그 외 문서는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
